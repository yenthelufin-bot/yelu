# Kopieer dit bestand naar .env en vul je sleutels in.

# Google Cloud-sleutel met deze API's aan: Geocoding API, Places API (New),
# Street View Static API en Maps Embed API.
GOOGLE_MAPS_API_KEY=

# Sleutel van https://console.anthropic.com (voor het beoordelen van de beelden).
ANTHROPIC_API_KEY=

# Optioneel
# PORT=4173
# SCOUT_DATA_DIR=./data
