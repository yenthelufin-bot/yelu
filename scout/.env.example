# Kopieer dit bestand naar .env en vul je sleutel in.

# Google Cloud-sleutel met deze API's aan: Geocoding API, Places API (New),
# Street View Static API en Maps Embed API. Location Scout blijft binnen
# het gratis maandelijkse gebruik van Google.
GOOGLE_MAPS_API_KEY=

# Gratis sleutel van https://aistudio.google.com/apikey (in een project zonder
# facturatie), voor het beoordelen van de foto's. Ook in te vullen in de app
# zelf, bij Instellingen.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optioneel en betaald: Claude via de API in plaats van Gemini.
# ANTHROPIC_API_KEY=

# Optioneel
# PORT=4173
# SCOUT_DATA_DIR=./data
# SCOUT_FREE_LIMITS=off   # schakelt de gratis-grens uit (dan kan Google kosten aanrekenen)

# ---------- Online versie (op een server) ----------
# Met een wachtwoord draait Frame Finder als online versie: iedereen logt in
# met dit wachtwoord (minstens 10 tekens) en de sleutels hierboven zijn niet
# aan te passen vanuit de browser.
# FRAMEFINDER_PASSWORD=
# HOST=0.0.0.0
# Aparte sleutel voor de 360°-weergave in de browser: alleen Maps Embed API,
# beperkt tot je eigen adres (bv. https://framefinder.yeluvisuals.com/*).
# GOOGLE_EMBED_KEY=
